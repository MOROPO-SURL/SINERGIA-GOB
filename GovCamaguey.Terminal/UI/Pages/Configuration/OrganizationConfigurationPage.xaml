<core_ui_base_pages:ConfigurationBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_configuration_page_models="clr-namespace:MOROPO.SINETGIAGOB.GovCamaguey.Terminal.Models.Page.Configuration"
    xmlns:core_models="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.Models;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    xmlns:core_interop_common_display_models="clr-namespace:MOROPO.SINETGIAGOB.Core.Interop.API.Common.Models.Display;assembly=MOROPO.SINETGIAGOB.Core.Interop.API.Common"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.SINETGIAGOB.GovCamaguey.Interop.API.Common.Models.Display;assembly=MOROPO.SINETGIAGOB.GovCamaguey.Interop.API.Common"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.SINETGIAGOB.GovCamaguey.Terminal.UI.Pages.Configuration.OrganizationConfigurationPage"
    x:TypeArguments="interop_common_display_models:OrganizationDisplayModel,interop_common_display_models:OrganizationDisplayModel,local_configuration_page_models:OrganizationConfigurationPageModel"
    x:DataType="local_configuration_page_models:OrganizationConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="RootFlexLayoutItemResponsiveWithConverter" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="WrappedFlexLayoutItemResponsiveWithConverter" WrapSpacing="4" SingleSpacing="4" />
            <core_ui_converters:FlexLayoutItemResponsiveWithConverter x:Key="PostalContactDetailFlexLayoutItemResponsiveWithConverter" SingleSpacing="8" />
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />

            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf12c;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xf156;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0" Margin="8">
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Frame
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource RootFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=3, LargeContainerColumn=4, SmallContainerColumn=6}}"
                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                        VerticalOptions="Start"
                        Margin="4"
                        Padding="0">
                        <Grid>
                            <Image Source="{Binding ImageSource, TargetNullValue='default_organization_picture.png'}" />
                            <Grid BackgroundColor="#A7000000">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ImageLayoutTapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Text="&#xF8CB;"
                                    TextColor="White"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    FontFamily="MaterialDesignIcons"
                                    FontSize="96" />
                            </Grid>
                        </Grid>
                    </Frame>
                    <VerticalStackLayout WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource RootFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=9, LargeContainerColumn=8, MediumContainerColumn=12}}">
                        <VerticalStackLayout 
                            Margin="4"
                            Spacing="6">
                            <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Nombre" />
                            <Entry Text="{Binding Name}" />
                            <Label
                                IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static local_configuration_page_models:OrganizationConfigurationPageModel.NameValidableProperty}}"
                                Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static local_configuration_page_models:OrganizationConfigurationPageModel.NameValidableProperty}}"
                                TextColor="IndianRed" />
                        </VerticalStackLayout>
                        <FlexLayout 
                            Wrap="Wrap"
                            AlignItems="Start" AlignContent="Start">
                            <VerticalStackLayout 
                                WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource WrappedFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel LargeContainerColumn=3, MediumContainerColumn=6, SmallContainerColumn=12}}"
                                Margin="4"
                                Spacing="6">
                                <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Alias (opcional)" />
                                <Entry Text="{Binding Alias}" />
                            </VerticalStackLayout>
                        </FlexLayout>
                    </VerticalStackLayout>
                </FlexLayout>
                <FlexLayout
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource WrappedFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Teléfonos" />                    
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="PhoneContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Color="DimGray" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding PhoneContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:PhoneContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            LineBreakMode="TailTruncation"
                                                            FontAttributes="Bold" />
                                                        <Label 
                                                            Margin="8,4" 
                                                            Text="{Binding PhoneNumber}"
                                                            LineBreakMode="TailTruncation"
                                                            FontSize="Medium" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        Style="{StaticResource FontIconImageButtonStyle}"
                                                        VerticalOptions="Center"
                                                        Text="&#xF90B;"
                                                        Clicked="PhoneContactItemEditionButton_Clicked" />
                                                    <Button
                                                        Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                        VerticalOptions="Center"
                                                        Text="&#xFA78;"
                                                        Clicked="PhoneContactItemRemotionButton_Clicked" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout 
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource WrappedFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel ExtraLargeContainerColumn=6, LargeContainerColumn=12}}"
                        Margin="4"
                        Spacing="6">
                        <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Correos electrónicos" />
                        <Frame Padding="8">
                            <Grid RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Column="1" Grid.Row="0"
                                    HorizontalOptions="End"
                                    Text="Agregar"
                                    Clicked="EmailContactItemAgregationButton_Clicked" />
                                <BoxView
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Color="DimGray" />
                                <CollectionView
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    ItemsSource="{Binding EmailContactItems}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="4" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.EmptyView>
                                        <Label Margin="10" Text="Sin elementos que mostrar" FontAttributes="Italic" TextColor="DimGray" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="core_interop_common_display_models:EmailContactItemDisplayModel">
                                            <Frame 
                                                Padding="8"
                                                Margin="0,12,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <VerticalStackLayout 
                                                        HorizontalOptions="FillAndExpand"
                                                        Margin="8">
                                                        <Label 
                                                            IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}"
                                                            Margin="4,0"
                                                            Text="{Binding Label}"
                                                            LineBreakMode="TailTruncation"
                                                            FontAttributes="Bold" />
                                                        <Label 
                                                            Margin="8,4" 
                                                            Text="{Binding EmailAddress}"
                                                            LineBreakMode="TailTruncation"
                                                            FontSize="Medium" />
                                                    </VerticalStackLayout>
                                                    <Button
                                                        Style="{StaticResource FontIconImageButtonStyle}"
                                                        VerticalOptions="Center"
                                                        Text="&#xF90B;"
                                                        Clicked="EmailContactItemEditionButton_Clicked" />
                                                    <Button
                                                        Style="{StaticResource DangerKindFontIconImageButtonStyle}"
                                                        VerticalOptions="Center"
                                                        Text="&#xFA78;"
                                                        Clicked="EmailContactItemRemotionButton_Clicked" />
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </FlexLayout>
                <VerticalStackLayout 
                    Margin="8"
                    Spacing="6">
                    <Label Style="{StaticResource CaptionFieldLabelStyle}" Text="Descrición (Opcional)" />
                    <Editor Text="{Binding About}" HeightRequest="200" />
                </VerticalStackLayout>
                <BoxView 
                    Margin="8,16,8,8"
                    HeightRequest="1" 
                    Color="DimGray" />
                <FlexLayout 
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start">
                    <Grid
                        WidthRequest="{Binding Source={RelativeSource AncestorType={Type FlexLayout}}, Path=Width, Converter={StaticResource RootFlexLayoutItemResponsiveWithConverter}, ConverterParameter={core_models:ResponsiveColumnConfigurationModel UltraLargeContainerColumn=1, ExtraLargeContainerColumn=2, LargeContainerColumn=3, MediumContainerColumn=4, SmallContainerColumn=6}}"
                        Margin="4"
                        ColumnSpacing="6" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Row="0"
                            Style="{StaticResource CaptionFieldLabelStyle}" Text="Prioridad" />
                        <Entry
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            IsReadOnly="True"
                            Text="{Binding Priority}" />
                        <Stepper
                            Grid.Row="1"
                            Margin="0,0,6,0"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Priority}" />
                    </Grid>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</core_ui_base_pages:ConfigurationBaseContentPage>