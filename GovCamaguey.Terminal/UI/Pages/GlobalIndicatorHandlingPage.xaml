<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_page_models="clr-namespace:MOROPO.SINETGIAGOB.GovCamaguey.Terminal.Models.Page"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.SINETGIAGOB.GovCamaguey.Interop.API.Common.Models.Display;assembly=MOROPO.SINETGIAGOB.GovCamaguey.Interop.API.Common"
    xmlns:fwrk_core_presentation_behaviors="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Behaviors;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    xmlns:caneyframework_presentation_views="clr-namespace:MOROPO.Framework.Caney.Presentation.UI.Views;assembly=MOROPO.Framework.Caney.Presentation"
    xmlns:communitytoolkit_converters="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
    x:Class="MOROPO.SINETGIAGOB.GovCamaguey.Terminal.UI.Pages.GlobalIndicatorHandlingPage"
    x:DataType="local_page_models:GlobalIndicatorHandlingPageModel"
    Title="Actualización de Indicadores Globales">
    <ContentPage.Resources>
        <ResourceDictionary>
            <communitytoolkit_converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF450;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Exportar Todos"
            Clicked="DownloadAllToolbarItems_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF222;" Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid>
        <CollectionView Margin="10" ItemsSource="{Binding Indicators}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Behaviors>
                <fwrk_core_presentation_behaviors:AdaptableGridItemLayoutCollectionViewBehavior ItemWidth="400" ItemSpacing="20" />
            </CollectionView.Behaviors>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="interop_common_display_models:GlobalIndicatorDisplayModel">
                    <Frame Padding="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout 
                                Grid.Column="0"
                                VerticalOptions="Center">
                                <Label Text="{Binding Name}" />
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontAttributes="Bold" Text="Meta: " />
                                            <Span Text="{Binding Amount}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout 
                                Grid.Column="1"
                                VerticalOptions="Center">
                                <Label 
                                    FontAttributes="Bold"
                                    Text="Estado" />
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span x:Name="BalanceSpan" Text="{Binding Balance, Mode=OneTime}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding UnitMeasurement.Symbol}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Button
                                Style="{StaticResource FontIconImageButtonStyle}"
                                Grid.Column="2"
                                VerticalOptions="Center"
                                Text="&#xF90B;"
                                Clicked="ResultUpgradeButton_Clicked" />
                            <Button
                                Style="{StaticResource FontIconImageButtonStyle}"
                                IsEnabled="{Binding ResultAt, Converter={StaticResource IsNotNullConverter}}"
                                Grid.Column="3"
                                VerticalOptions="Center"
                                Text="&#xF2FD;"
                                Clicked="LastResultDetailButton_Clicked" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <caneyframework_presentation_views:BusyView IsVisible="{Binding IsBusy}"/>
    </Grid>
</ContentPage>