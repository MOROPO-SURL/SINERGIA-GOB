<?xml version="1.0" encoding="utf-8" ?>
<core_ui_base_pages:DetailBaseContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local_data_models="clr-namespace:MOROPO.SINETGIAGOB.GovCamaguey.Terminal.Models.Data"
    xmlns:core_ui_base_pages="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Pages.Base;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.SINETGIAGOB.GovCamaguey.Terminal.UI.Pages.Detail.CommonIndicatorResultDetailPage"
    x:TypeArguments="local_data_models:CommonIndicatorResultDataModel"
    x:DataType="local_data_models:CommonIndicatorResultDataModel"
    Title="Detalles de Indicador Global"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="400"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <VerticalStackLayout Margin="20">
                        <Label 
                            Margin="0,0,0,8"
                            Text="Detalles"
                            FontAttributes="Bold"
                            FontSize="Medium" />
                        <Label 
                            Margin="0,0,0,12"
                            Text="Última actualización"
                            FontAttributes="Bold" />
                        <Label
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Margin="0"
                            Text="Fecha" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding At}" />
                        <Label 
                            Style="{StaticResource CaptionPropertyLabelStyle}"
                            Text="Descripción" />
                        <Label
                            Style="{StaticResource ValuePropertyLabelStyle}"
                            Text="{Binding Description, TargetNullValue='---'}" />
                    </VerticalStackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</core_ui_base_pages:DetailBaseContentPage>