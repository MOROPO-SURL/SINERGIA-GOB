<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Views.ModuleFlyoutSectionTitleContentView">
    <VerticalStackLayout Padding="12" Spacing="8">
        <Label
            Text="{Binding Text}"
            FontSize="Medium"
            FontAttributes="Bold" />
        <BoxView
            Color="LightGray"
            HeightRequest="1" />
    </VerticalStackLayout>
</ContentView>
