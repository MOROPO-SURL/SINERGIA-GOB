<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_presentation_page_models="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.Models.Page;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    xmlns:core_ui_converters="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Default.Pages.SettingPage"
    x:DataType="core_presentation_page_models:SettingPageModel"
    Title="Configuración"
    BackgroundColor="Transparent"
    Background="{StaticResource OverlayBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <core_ui_converters:ValidationResultToTargetPropertyErrorMessageConverter x:Key="ValidationResultToTargetPropertyErrorMessageConverter" />
            <core_ui_converters:ValidationResultToTargetPropertyHasErrorConverter x:Key="ValidationResultToTargetPropertyHasErrorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid
                Padding="10"
                MaximumWidthRequest="480"
                VerticalOptions="Center">
                <Frame Style="{StaticResource PopupFrameStyle}">
                    <StackLayout Margin="20" Spacing="20">
                        <StackLayout Spacing="10">
                            <Label 
                                Margin="0,0,0,20"
                                Text="Configuración"
                                FontAttributes="Bold"
                                FontSize="Medium" />
                            <StackLayout Orientation="Vertical" Spacing="6">
                                <Label
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                    Text="Usar proxy de red" />
                                <Switch 
                                    VerticalOptions="Center"
                                    IsToggled="{Binding UseProxyServer}" />
                            </StackLayout>
                            <VerticalStackLayout IsVisible="{Binding UseProxyServer}" Spacing="6">
                                <Label 
                                    Style="{StaticResource CaptionFieldLabelStyle}"
                                    Text="Dirección del servidor proxy" />
                                <Entry
                                    Placeholder="http(s)://proxy.address.net(:3128)"
                                    Text="{Binding ProxyServerAddress}" />
                                <Label
                                    IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyServerAddressValidableProperty}}"
                                    Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyServerAddressValidableProperty}}"
                                    Style="{StaticResource ValidationMessageLabelStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding UseProxyServer}" Spacing="10">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                                        Text="Proxy requiere autenticación" />
                                    <Switch 
                                        VerticalOptions="Center"
                                        IsToggled="{Binding UseProxyAuthentication}" />
                                </StackLayout>
                                <VerticalStackLayout IsVisible="{Binding UseProxyAuthentication}" Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        Text="Usuario de proxy" />
                                    <Entry Text="{Binding ProxyUsername}" />
                                    <Label
                                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyUsernameValidableProperty}}"
                                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyUsernameValidableProperty}}"
                                        Style="{StaticResource ValidationMessageLabelStyle}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding UseProxyAuthentication}" Spacing="6">
                                    <Label 
                                        Style="{StaticResource CaptionFieldLabelStyle}"
                                        Text="Contraseña de proxy" />
                                    <Entry Text="{Binding ProxyPassword}" IsPassword="True" />
                                    <Label
                                        IsVisible="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyHasErrorConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyPasswordValidableProperty}}"
                                        Text="{Binding ValidationResult, Converter={StaticResource ValidationResultToTargetPropertyErrorMessageConverter}, ConverterParameter={Static core_presentation_page_models:SettingPageModel.ProxyPasswordValidableProperty}}"
                                        Style="{StaticResource ValidationMessageLabelStyle}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </StackLayout>
                        <StackLayout
                            Orientation="Horizontal"
                            Spacing="20">
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Aplicar"
                                Command="{Binding ApplyChangesCommand}" />
                            <Button 
                                HorizontalOptions="FillAndExpand"
                                Text="Cancelar"
                                Clicked="DismissControl_Invoked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <Button
                    Style="{StaticResource DetailPageCloseButtonStyle}"
                    Clicked="DismissControl_Invoked" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>