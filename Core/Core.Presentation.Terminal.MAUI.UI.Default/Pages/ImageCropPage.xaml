<?xml version="1.0" encoding="utf-8" ?>
<caneyframework_mvvm_pages:ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:caneyframework_mvvm_pages="clr-namespace:MOROPO.Framework.Caney.MVVM.Core.Pages;assembly=MOROPO.Framework.Caney.MVVM"
    x:Class="MOROPO.SINERGIAGOB.Core.Presentation.Terminal.MAUI.UI.Default.Pages.ImageCropPage"
    Title="Recortar imagen">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Order="Primary"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    Glyph="&#xf12c;"
                    FontFamily="MaterialDesignIcons">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Order="Primary"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    Glyph="&#xf156;"
                    FontFamily="MaterialDesignIcons">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid
                x:Name="CropCanvasWrapper"
                Grid.ColumnSpan="3" Grid.RowSpan="2" />
            <Button 
                Grid.Column="1" Grid.Row="0"
                Margin="10,10,0,10"
                BackgroundColor="#99A9A9A9"
                Text="&#xf465;"
                TextColor="White"
                FontSize="Title"
                FontFamily="MaterialDesignIcons"
                Clicked="RotateToLeftButton_Clicked" />
            <Button 
                Grid.Column="2" Grid.Row="0"
                Margin="10"
                BackgroundColor="#99A9A9A9"
                Text="&#xf467;"
                TextColor="White"
                FontSize="Title"
                FontFamily="MaterialDesignIcons"
                Clicked="RotateToRightButton_Clicked" />
        </Grid>
    </ContentPage.Content>
</caneyframework_mvvm_pages:ContentPage>