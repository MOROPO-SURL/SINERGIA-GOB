<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interop_common_display_models="clr-namespace:MOROPO.SINETGIAGOB.Core.Interop.API.Common.Models.Display;assembly=MOROPO.SINETGIAGOB.Core.Interop.API.Common"
    xmlns:core_ui_converters="clr-namespace:MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Converters;assembly=MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI"
    x:Class="MOROPO.SINETGIAGOB.Core.Presentation.Terminal.MAUI.UI.Default.Views.Card.UserDefaultCardView"
    x:DataType="interop_common_display_models:UserDisplayModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <core_ui_converters:ImageDisplayModelToImageSourceConverter x:Key="ImageDisplayModelToImageSourceConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Frame Padding="16">
        <Grid ColumnSpacing="6" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Grid.Column="0" Grid.RowSpan="2"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                StrokeThickness="4"
                StrokeLineJoin="Bevel">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Image
                    WidthRequest="72" HeightRequest="72"
                    Source="{Binding Identity.Image, Converter={StaticResource ImageDisplayModelToImageSourceConverter}, TargetNullValue='default_person_picture.jpg'}" />
            </Border>
            <Label
                Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                VerticalOptions="End"
                LineBreakMode="TailTruncation" 
                Text="{Binding Id}"
                FontSize="Medium"
                FontAttributes="Bold" />
            <Label
                Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                VerticalOptions="Start"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                FontSize="Default">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Identity.Name}" />
                        <Span Text=" " />
                        <Span Text="{Binding Identity.LastName}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
    </Frame>
</ContentView>
