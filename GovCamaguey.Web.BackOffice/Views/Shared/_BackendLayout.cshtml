<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>SINERGIA GOB Camagüey Admin | @ViewData["TITLE"]</title>

    <!-- Custom fonts for this template-->
    <link href="~/vendor/MaterialDesign-Webfont/css/materialdesignicons.min.css" rel="stylesheet" type="text/css" />
    @* <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" /> *@

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet" />

    <style type="text/css">
        th.fit, td.ft {
            width: 1px;
            word-wrap: unset;
        }

        th.width-short {
            width: 296px;
        }

        th.width-medium {
            width: 302px;
        }

        th.width-large {
            width: 320px;
        }

        th.width-extra-large {
            width: 420px;
        }

        button.btn-set-archived {
            width: 102px;
        }

        .card .card-header[data-toggle=collapse]::after {
            font-family: 'Material Design Icons';
            content: '\F143';
            color: black;
        }

        .card .card-header[data-toggle=collapse].collapsed::after {
            content: '\F140';
        }

        .sidebar #sidebarToggle::after {
            font-family: 'Material Design Icons';
            content: '\F141';
        }

        .sidebar.toggled #sidebarToggle::after {
            font-family: 'Material Design Icons';
            content: '\F142';
        }

        .display-archived {
            text-decoration: line-through;
            color: lightgray;
        }
    </style>

    @RenderSection("styles", false)

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        @await Component.InvokeAsync("DashboardSidebar")
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Search -->
                    <form class="d-none d-sm-inline-block form-inline mr-auto my-2 my-md-0 mw-100 navbar-search">
                        <div class="input-group">
                            <input type="text" class="form-control bg-light border-0 small" placeholder="Búsqueda global ..."
                                   aria-label="Search" aria-describedby="basic-addon2">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button">
                                    <i class="mdi mdi-search-web"></i>
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity.Name</span>
                                <img class="img-profile rounded-circle"
                                     src="/img/default-person-picture.jpg">
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" asp-action="index" asp-controller="account" asp-area="security">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profile
                                </a>
                                <a class="dropdown-item" asp-action="password" asp-controller="account" asp-area="security">
                                    <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Contraseña
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Logout
                                </a>
                            </div>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->
                <!-- Begin Page Content -->
                <div class="container-fluid">
                    @{
                        var notificationEntries = TempData.Where(x => x.Key.EndsWith("-notification")).ToArray();

                        foreach (var extraNotificationEntry in notificationEntries)
                        {
                            var notification = JsonConvert.DeserializeObject<NotificationViewModel>(extraNotificationEntry.Value.ToString());

                            <div class="alert alert-dismissible fade show alert-@Html.Raw(notification.Type.ToString().ToLower())">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                @if (notification.Title != null)
                                {
                                    <h4>@notification.Title</h4>
                                }

                                @if (notification.Message != null)
                                {
                                    @Html.Raw(notification.Message);
                                }

                                @if (notification.Messages != null)
                                {
                                    <ul>
                                        @foreach (var item in notification.Messages)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }

                    @if (ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] != null)
                    {
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-5">
                                @{
                                    ICollection<BreadcrumbViewModel> breadcrumbs = ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] as ICollection<BreadcrumbViewModel>;

                                    if (breadcrumbs != null)
                                    {
                                        var total = breadcrumbs.Count();
                                        var count = 1;

                                        foreach (var breadcrumb in breadcrumbs)
                                        {
                                            if (count < total)
                                            {
                                                <li class="breadcrumb-item"><a href="@breadcrumb.Url">@Html.Raw(breadcrumb.Caption)</a></li>
                                            }
                                            else
                                            {
                                                <li class="breadcrumb-item active">@Html.Raw(breadcrumb.Caption)</li>
                                            }

                                            count++;
                                        }
                                    }
                                }
                            </ol>
                        </nav>
                    }

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800">@ViewData["HEADER"]</h1>
                    </div>

                    @RenderBody()
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; MOROPO S.U.R.L. @System.DateTime.Now.Year</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="mdi mdi-chevron-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            @using (Html.BeginForm("logout", "account", new { Area = "security" }, FormMethod.Post, true, new { @class = "modal-content" }))
            {
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Terminar la sesión?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">De click en "Salir" si está seguro que desea terminar la sesión.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                    <input class="btn btn-primary" type="submit" value="Salir" />
                </div>
            }
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(document).on("click", "button.filter-form-reseter", function (e) {
                $(e.target.form).find("select option").prop("selected", false);

                $(e.target.form).find("input[type=text]").prop("value", '');

                e.target.form.submit();
            });

            $(document).on("click", "input[type='submit']", function (e) {
                if (!e.target.form) return;

                e.preventDefault();

                $(e.target.form).find("input").addClass('readonly', 'readonly');
                $(e.target.form).find("select").attr('readonly', 'readonly');
                $(e.target.form).find("button").attr('disabled', 'disabled');
                $(e.target.form).find("a.btn").attr('disabled', 'disabled');

                e.target.form.submit();
            });

            $(document).on("click", "button[type='submit']", function (e) {
                if (!e.target.form) return;

                e.preventDefault();

                $(e.target.form).find("input").addClass('readonly', 'readonly');
                $(e.target.form).find("select").attr('readonly', 'readonly');
                $(e.target.form).find("button").attr('disabled', 'disabled');
                $(e.target.form).find("a.btn").attr('disabled', 'disabled');

                e.target.form.submit();
            });
        });
    </script>

    @RenderSection("scripts", false)

</body>

</html>