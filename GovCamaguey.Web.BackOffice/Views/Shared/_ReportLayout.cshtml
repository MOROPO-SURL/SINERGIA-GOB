<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Decisor Base System">
    <meta name="author" content="MOROPO S.U.R.L.">

    <title>SINERGIA GOB Camagüey</title>

    <style type="text/css">
        body {
            margin: 0;
            padding: 10px;
            background-color: #F7F7F7;
            font-family: Arial, sans-serif;
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.0;
            color: black;
        }

        table {
            border-collapse: collapse;
            background-color: white;
            width: 100%;
        }

        table th,
        table td {
            padding: 0.25rem;
            vertical-align: top;
            border: 2px solid black;
            vertical-align: middle;
            text-align: center;
        }

        @@media print {
            body {
                padding: 0;
                background-color: white;
            }
        }
    </style>

    @RenderSection("styles", false)
</head>
<body>
    @RenderBody()
</body>
</html>