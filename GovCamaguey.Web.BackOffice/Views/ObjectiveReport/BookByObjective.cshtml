@model MOROPO.SINERGIAGOB.GovCamaguey.Web.BackOffice.Models.View.ObjectiveSummaryViewModel

@{
    Layout = "_ReportLayout";

    string emptyMessage = "No se definieron elementos";
}

@section styles {
    <style type="text/css">
        body {
            font-family: Arial, sans-serif;
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.0;
        }

        table {
            background-color: transparent;
        }

            table td {
                border: none;
                width: 50%;
                text-align: left;
            }

                table td > h5 {
                    margin-top: 0;
                }

        h5.h-seccion {
            font-style: italic; 
            text-decoration: underline;
            margin-bottom: 12px;
        }

        li.li-indicator {
            margin-bottom: 12px;
        }

            li.li-indicator > p {
                margin-top: 8px;
            }

        .text-muted {
            color: dimgray;
            font-style: italic;
            font-size: 0.92rem;
        }
    </style>
}

<h2>@Model.Index. @Model.Name</h2>
@if (!string.IsNullOrEmpty(Model.Description))
{
    <p>@Model.Description</p>
}
<h5 class="h-seccion">Indicadores</h5>
@if (Model.Indicators.Length <= 0)
{
    <div class="text-muted">@emptyMessage</div>
}
else
{
    <ul>
        @foreach (var _item in Model.Indicators)
        {
            <li class="li-indicator">
                <div><span>@_item.Name</span></div>
                <div><b>Meta: </b> @_item.Amount @_item.UnitMeasurement.Symbol</div>
                @if (!string.IsNullOrEmpty(_item.Description))
                {
                    <p>@_item.Description</p>
                }
            </li>
        }
    </ul>
}
<h5 class="h-seccion">Objetivos específicos</h5>
@if (Model.Proyections.Length <= 0)
{
    <div class="text-muted">@emptyMessage</div>
}
else
{
    <ul>
        @foreach (var _item in Model.Proyections)
        {
            <li>
                <h3>@Model.Index.@_item.Index @_item.Name</h3>
                @if (!string.IsNullOrEmpty(_item.Description))
                {
                    <p>@_item.Description</p>
                }
                <table style="border: none;">
                    <tbody>
                        <tr>
                            <td style="border: none;">
                                <h5 class="h-seccion">Responsables</h5>
                                @if (_item.ResponsabilityOrganizations.Length <= 0)
                                {
                                    <div class="text-muted">@emptyMessage</div>
                                }
                                else
                                {
                                    <ul>
                                        @foreach (var __item in _item.ResponsabilityOrganizations)
                                        {
                                            <li>@__item.Identity.Name</li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td style="border: none;">
                                <h5 class="h-seccion">Participantes</h5>
                                @if (_item.ParticipationOrganizations.Length <= 0)
                                {
                                    <div class="text-muted">@emptyMessage</div>
                                }
                                else
                                {
                                    <ul>
                                        @foreach (var __item in _item.ParticipationOrganizations)
                                        {
                                            <li>@__item.Identity.Name</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <h5 class="h-seccion">Indicadores</h5>
                @if (_item.Indicators.Length <= 0)
                {
                    <div class="text-muted">@emptyMessage</div>
                }
                else
                {
                    <ul>
                        @foreach (var __item in _item.Indicators)
                        {
                            <li class="li-indicator">
                                <div><span>@__item.Name</span></div>
                                <div><b>Meta: </b> @__item.Amount @__item.UnitMeasurement.Symbol</div>
                                @if (!string.IsNullOrEmpty(__item.Description))
                                {
                                    <p>@__item.Description</p>
                                }
                            </li>
                        }
                    </ul>
                }
                <h5 class="h-seccion">Acciones</h5>
                @if (_item.Actions.Length <= 0)
                {
                    <div class="text-muted">@emptyMessage</div>
                }
                else
                {
                    <ul>
                        @foreach (var __item in _item.Actions)
                        {
                            <li>
                                <h4>@Model.Index.@_item.Index.@__item.Index @__item.Name</h4>
                                @if (!string.IsNullOrEmpty(__item.Description))
                                {
                                    <p>@__item.Description</p>
                                }
                                <table>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <h5 class="h-seccion">Responsables</h5>
                                                @{
                                                    var responsibleBridges = __item.OrganizationResponsabilityBridges.Where(bridge => !bridge.Stern.Archived).ToArray();

                                                    if (responsibleBridges.Length <= 0)
                                                    {
                                                        <div class="text-muted">@emptyMessage</div>
                                                    }
                                                    else
                                                    {
                                                        <ul>
                                                            @foreach (var ___item in responsibleBridges)
                                                            {
                                                                <li>@___item.Stern.Identity.Name</li>
                                                            }
                                                        </ul>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <h5 class="h-seccion">Participantes</h5>
                                                @{
                                                    var participationBridges = __item.OrganizationParticipationBridges.Where(bridge => !bridge.Stern.Archived).ToArray();

                                                    if (participationBridges.Length <= 0)
                                                    {
                                                        <div class="text-muted">@emptyMessage</div>
                                                    }
                                                    else
                                                    {
                                                        <ul>
                                                            @foreach (var ___item in participationBridges)
                                                            {
                                                                <li>@___item.Stern.Identity.Name</li>
                                                            }
                                                        </ul>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <h5 class="h-seccion">Indicadores</h5>
                                @if (__item.Indicators.Count <= 0)
                                {
                                    <div class="text-muted">@emptyMessage</div>
                                }
                                else
                                {
                                    <ul>
                                        @foreach (var ___item in __item.Indicators)
                                        {
                                            <li class="li-indicator">
                                                <div><span>@___item.Name</span></div>
                                                <div><b>Meta: </b> @___item.Amount @___item.UnitMeasurement.Symbol</div>
                                                @if (!string.IsNullOrEmpty(___item.Description))
                                                {
                                                    <p>@___item.Description</p>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
}