<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>MOROPO.SINERGIAGOB.GovCamaguey.Web.BackOffice</AssemblyName>
		<RootNamespace>MOROPO.SINERGIAGOB.GovCamaguey.Web.BackOffice</RootNamespace>
		<VersionPrefix>1.1.4</VersionPrefix>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="dpkeys\**" />
		<Compile Remove="logs\**" />
		<Content Remove="dpkeys\**" />
		<Content Remove="logs\**" />
		<EmbeddedResource Remove="dpkeys\**" />
		<EmbeddedResource Remove="logs\**" />
		<None Remove="dpkeys\**" />
		<None Remove="logs\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="GuamaFramework.Core.Presentation.Web.API" Version="6.0.2" />
		<PackageReference Include="GuamaFramework.Core.Security.Common.Presentation.Web.Frontend" Version="6.0.2" />
		<PackageReference Include="GuamaFramework.Location.Presentation.Web.Backend" Version="6.0.2" />
		<PackageReference Include="GuamaFramework.Media.Presentation.Web.Common" Version="6.0.2" />
		<PackageReference Include="GuamaFramework.Security.Personal.Presentation.Web.Backend" Version="6.0.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="7.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="7.0.4" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Core\Core.Persistence.ORM.EF\Core.Persistence.ORM.EF.csproj" />
	  <ProjectReference Include="..\Core\Core.Presentation.Web.Backend\Core.Presentation.Web.Backend.csproj" />
	  <ProjectReference Include="..\Core\Core.Presentation.Web.Frontend\Core.Presentation.Web.Frontend.csproj" />
	  <ProjectReference Include="..\GovCamaguey.Interop.API.Common\GovCamaguey.Interop.API.Common.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Content Update="appsettings.Development.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Update="appsettings.Staging.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Properties\launchSettings.json">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </None>
	</ItemGroup>

</Project>
