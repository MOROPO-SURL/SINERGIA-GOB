@model MOROPO.Framework.Guama.Core.Presentation.Web.Frontend.Models.View.PaginationViewModel<MOROPO.SINERGIAGOB.GovCamaguey.Persistence.Entities.ActionIndicatorResult, long, MOROPO.SINERGIAGOB.GovCamaguey.Web.BackOffice.Models.View.Display.ActionIndicatorResultDisplayViewModel>

@{
    const string HEADER = "Administración de Resultados (Idicadores de Acción)";

    ViewData["TITLE"] = ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"mdi mdi-desktop-mac-dashboard\"></i> Panel de Control",
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

<div class="card">
    <div class="card-header">
        <h5 class="m-0 font-weight-bold text-primary">Listado de elementos</h5>
    </div>
    <div class="card-body">
        @if (Model.HasNext || Model.HasPrevious)
        {
            var paginationStart = (Model.Page - 1) * Model.Limit + 1;
            var paginationEnd = paginationStart - 1 + Model.List.Count;

            <div class="row">
                <div class="col mb-2">
                    <span style="font-weight: 600;">Mostrando página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
                </div>
                <div class="col-auto mb-2">
                    <ul class="pagination">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                        }

                        @if (Model.MaxPageCount > 5)
                        {
                            if (Model.Page > 3)
                            {
                                if (Model.MaxPageCount - Model.Page < 3)
                                {
                                    for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                                else
                                {
                                    for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                            }
                            else
                            {
                                for (var i = 1; i <= 5; i++)
                                {
                                    if (i == Model.Page)
                                    {
                                        <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                    }
                                }
                            }
                        }
                        else
                        {
                            for (var i = 1; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }

                        @if (Model.HasNext)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div style="border: 1px solid #DDD; border-radius: 4px;">
            <table class="table table-bordered table-striped m-0">
                <thead>
                    <tr>
                        <th>Acción</th>
                        <th>Indicador</th>
                        <th>Monto</th>
                        <th>Unidad de Medida</th>
                        <th class="fit width-short">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.List.Count > 0)
                    {
                        foreach (var item in Model.List)
                        {
                            <tr>
                                <td style="vertical-align: middle;" title="Acción">
                                    <span>@item.Indicator.Action.Proyection.Objective.Index.@item.Indicator.Action.Proyection.Index.@item.Indicator.Action.Index</span>
                                </td>
                                <td style="vertical-align: middle;" title="Nombre">
                                    <span>@item.Indicator.Name</span>
                                </td>
                                <td style="vertical-align: middle;" title="Monto">
                                    <span>@item.Amount</span>
                                </td>
                                <td style="vertical-align: middle;" title="Unidad de Medida">
                                    <span>@item.Indicator.UnitMeasurement.Name</span>
                                </td>
                                <td class="fit" style="vertical-align: middle;">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-eye"></span><span>Detalles</span></button>
                                        <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can"></span><span>Eliminar</span></button>
                                    </div>

                                    <div class="modal fade " id="descrip-@item.Id" tabindex="-1" role="dialog" aria-labelledby="descrip-@item.Id-label" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title font-weight-bold text-primary" id="descrip-@item.Id-label">Detalles</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <dl class="mb-0">
                                                        <dt>Indicador</dt>
                                                        <dd>@item.Indicator.Name</dd>
                                                        <dt>Monto</dt>
                                                        <dd>@item.Amount</dd>
                                                        <dt>Unidad de Medida</dt>
                                                        <dd>@item.Indicator.UnitMeasurement.Name</dd>
                                                        <dt>Fecha</dt>
                                                        <dd>@item.At</dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                @using (Html.BeginForm("delete", null, null, FormMethod.Post, true, new { @class = "modal-content" }))
                                                {
                                                    @Html.Hidden("Id", item.Id)

                                                    <div class="modal-header">
                                                        <h5 class="modal-title font-weight-bold text-primary" id="delete-@item.Id-lable">Eliminar Resultado</h5>
                                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-0">Está seguro que desea eliminar el resultado seleccionado?</p>
                                                    </div>
                                                    <div class="modal-footer" style="margin-top: 0;">
                                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

