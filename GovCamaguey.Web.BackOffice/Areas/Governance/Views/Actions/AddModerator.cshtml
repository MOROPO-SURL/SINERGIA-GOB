@model MOROPO.SINERGIAGOB.GovCamaguey.Web.BackOffice.Models.View.Input.Bridge.ActionUserBridgeInputModel

@{
    const string HEADER = "Administración de Acciones";
    const string TITLE = "Agregar Moderador de Acción";

    ViewData["HEADER"] = HEADER;

    ViewData["TITLE"] = TITLE;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span> Panel de Control",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = "Modificar Moderadores de Acción",
            Url = Url.Action("moderators", new { key = Model.ActionId }),
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("addmoderator", null, new { key = Model.ActionId }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@TITLE</h4></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.UserId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.UserId, Model.AvailableUsers.Select(model => new SelectListItem { Value = model.Id, Text = $"{model.Id} ({model.Name} {model.LastName})" }), new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.UserId, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("moderators", new { key = Model.ActionId })">Cancelar</a>
        </div>
    </div>
}