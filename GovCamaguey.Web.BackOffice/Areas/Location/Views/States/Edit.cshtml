@model MOROPO.Framework.Guama.Location.Presentation.Web.Backend.Models.View.StateInputViewModel

@{
    const string TITLE = "Modificar Provincia";
    const string HEADER = "Administración de Provincias";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span> Panel de Control",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "states", new { Area = "location", key = string.Empty }, FormMethod.Post))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header"><h4 class="mb-0">@TITLE</h4></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RegionId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.RegionId, Model.Regions, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.RegionId, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}